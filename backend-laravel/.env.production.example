APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.namaaplikasi.com
SANCTUM_STATEFUL_DOMAINS=api.namaaplikasi.com,namaaplikasi.com,www.namaaplikasi.com

# Path absolut ke Firebase Admin SDK service-account JSON di server Azure.
FIREBASE_CREDENTIALS=/home/site/wwwroot/storage/app/firebase/service-account.json
FIREBASE_API_KEY=

# URL publik backend untuk Steam OpenID callback.
STEAM_PUBLIC_URL=https://api.namaaplikasi.com

DB_CONNECTION=mysql
DB_HOST=<azure-mysql-host>
DB_PORT=3306
DB_DATABASE=<database-name>
DB_USERNAME=<database-user>
DB_PASSWORD=<database-password>

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
LOG_CHANNEL=stack
LOG_LEVEL=info